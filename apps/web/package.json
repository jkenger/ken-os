    "@ken-os/domain": "workspace:*",
    "@ken-os/portfolio": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@react-pdf/renderer": "^4.9.0",
    "@tabler/icons-react": "^3.49.0",
    "@xyflow/react": "12.12.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
