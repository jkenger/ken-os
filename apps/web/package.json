    "motion": "^14.14.0",
    "nanoid": "^6.0.2",
    "next": "latest",
    "next-themes": "^0.4.6",
    "postgres": "latest",
    "radix-ui": "^1.6.7",
    "react": "latest",
    "react-dom": "latest",
    "react-jsx-parser": "^2.4.1",
    "resend": "^6.37.0",
    "sanitize-html": "^2.18.1",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.8.1",
    "thinking-orbs": "^0.3.2",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@electric-sql/pglite": "0.5.8",
    "@stryker-mutator/core": "10.1.1",
