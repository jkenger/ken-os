    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@ken-os/agents": "workspace:*",
    "@ken-os/domain": "workspace:*",
    "@ken-os/portfolio": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@react-pdf/renderer": "^4.9.0",
    "@rive-app/react-webgl2": "^4.41.0",
    "@streamdown/cjk": "^1.0.5",
    "@streamdown/code": "^2.0.1",
    "@streamdown/math": "^1.0.4",
    "@streamdown/mermaid": "^1.0.4",
    "@tabler/icons-react": "^3.49.0",
    "@xyflow/react": "12.12.0",
    "ai": "^7.0.183",
    "ansi-to-react": "^6.2.6",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.2",
    "codemirror": "^6.0.2",
    "drizzle-orm": "^0.45.3",
    "embla-carousel-react": "^8.6.0",
