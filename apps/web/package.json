    "jose": "latest",
    "lucide-react": "^1.47.0",
    "mammoth": "^1.13.0",
    "next": "latest",
    "next-themes": "^0.4.6",
    "postgres": "latest",
    "radix-ui": "^1.6.7",
    "react": "latest",
    "react-dom": "latest",
    "resend": "^6.37.0",
    "sonner": "^2.0.8",
    "thinking-orbs": "^0.3.2",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1",
