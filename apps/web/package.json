{
  "name": "@ken-os/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/generate-lab-content.ts --check && tsx scripts/generate-studio-manifest.ts --check && next build",
    "start": "next start",
    "check": "tsx scripts/generate-lab-content.ts --check && tsx scripts/generate-studio-manifest.ts --check && tsc --noEmit",
    "design:bundle": "tsx scripts/build-design-bundle.ts",
    "memory:context": "tsx scripts/memory.ts context",
    "memory:submit": "tsx scripts/memory.ts submit",
    "test:db:memory": "tsx scripts/verify-memory.ts",
    "test": "tsx --test src/lib/*.test.ts src/features/project-memory/*.test.ts src/features/engineering-lab/*.test.ts src/features/terms/*.test.ts src/features/connector/*.test.ts src/features/profile/*.test.ts src/features/portfolio/*.test.ts src/features/design-studio/*.test.ts src/features/jobs/*.test.ts",
    "test:db:auth": "tsx scripts/verify-auth.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "lab:generate": "tsx scripts/generate-lab-content.ts --write",
    "studio:generate": "tsx scripts/generate-studio-manifest.ts --write",
    "studio:registries": "tsx scripts/fetch-studio-registries.ts",
    "test:db:engineering": "tsx scripts/verify-engineering.ts",
    "test:db:terms": "tsx scripts/verify-terms.ts",
    "test:db:connector": "tsx scripts/verify-connector.ts",
    "test:db:profile": "tsx scripts/verify-profile.ts",
    "db:migrate:deploy": "tsx scripts/migrate-on-deploy.ts",
    "test:db:portfolio": "tsx scripts/verify-portfolio.ts",
    "test:db:jobs": "tsx scripts/verify-jobs.ts"
  },
