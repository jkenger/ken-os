{
  "name": "@ken-os/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/generate-design-system.ts --check && tsx scripts/generate-lab-content.ts --check && next build",
    "start": "next start",
    "check": "tsx scripts/generate-design-system.ts --check && tsx scripts/generate-lab-content.ts --check && tsc --noEmit",
    "design:generate": "tsx scripts/generate-design-system.ts --write",
    "memory:context": "tsx scripts/memory.ts context",
    "memory:submit": "tsx scripts/memory.ts submit",
    "test:db:memory": "tsx scripts/verify-memory.ts",
    "test": "tsx --test src/lib/*.test.ts src/features/project-memory/*.test.ts src/features/engineering-lab/*.test.ts src/features/terms/*.test.ts",
    "lab:research": "tsx scripts/research.ts",
    "test:db": "tsx scripts/verify-skills.ts",
    "test:db:resume": "tsx scripts/verify-resume.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "lab:generate": "tsx scripts/generate-lab-content.ts --write",
    "lab:import-sources": "tsx scripts/import-sources.ts",
    "test:db:lab": "tsx scripts/verify-lab.ts",
    "test:db:profile": "tsx scripts/verify-profile.ts",
    "test:db:engineering": "tsx scripts/verify-engineering.ts",
    "test:db:terms": "tsx scripts/verify-terms.ts",
    "db:migrate:deploy": "tsx scripts/migrate-on-deploy.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@ken-os/agents": "workspace:*",
    "@ken-os/domain": "workspace:*",
    "@ken-os/drive": "workspace:*",
    "@tabler/icons-react": "^3.49.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.2",
    "codemirror": "^6.0.2",
    "drizzle-orm": "^0.45.3",
    "jose": "latest",
    "lucide-react": "^1.47.0",
    "next": "latest",
    "postgres": "latest",
    "radix-ui": "^1.6.7",
    "react": "latest",
    "react-dom": "latest",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
