APP_URL=http://localhost:3000
OWNER_EMAIL=you@example.com
DATABASE_URL=postgresql://user:password@localhost:5435/ken_os
DATABASE_URL_UNPOOLED=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=replace-with-at-least-32-random-characters
# Improve writing on Profile, and Terms
OPENAI_API_KEY=
# Autofill from an uploaded resume
ANTHROPIC_API_KEY=
# Claude connector: hosts allowed for OAuth redirect URIs and client metadata URLs. Defaults to claude.ai,claude.com
MCP_ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com
# Fallback Claude Project link for Ask Claude, until one is saved in Engineering → Settings (https://claude.ai/...)
KEN_OS_CLAUDE_PROJECT_URL=
# Jobs: Resend sends Loots' own emails (strong-match and digest, release step 4). Not used yet.
RESEND_API_KEY=
# Jobs: shared by every /api/jobs/check/<source> route, sent by the outside scheduler that polls them
JOBS_CHECK_SECRET=
