  "notes": {
    "t": {
      "x": 0,
      "y": -280,
      "text": "Loona agent: chat outcomes and activity log",
      "kind": "title1",
      "maxW": 4040
    },
    "n1": {
      "x": 4560,
      "y": 0,
      "w": 400,
      "text": "L1 → L2 → L3 or L4 is one thread over time. The dot pulses only while the run is pending (the chat polls); it stops and the outcome lands as its own new message. The composer stays usable throughout.",
      "fill": "blue"
    },
    "n2": {
      "x": 4560,
      "y": 1020,
      "w": 400,
      "text": "The chat never turns red. Failure is a plain assistant message that says what failed. Red, and the Added/Failed words, belong to the activity log.",
      "fill": "blue"
    },
    "n3": {
      "x": 4560,
      "y": 2040,
      "w": 400,
      "text": "Activity rows are read-only: no action, dismiss or delete. Newest first. The chip's word and icon shape carry the outcome; colour only reinforces it.",
      "fill": "blue"
    },
    "n4": {
      "x": 4560,
      "y": 3060,
      "w": 400,
      "text": "Tabs keep one route (/agents/loona?view=activity). The composer belongs to Chat and hides on Activity.",
      "fill": "blue"
    }
  },
  "designSystems": []
}
