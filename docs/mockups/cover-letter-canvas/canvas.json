    "nC": {
      "x": 1520,
      "y": 720,
      "w": 380,
      "text": "C1 and C2 open the Cover letter tab on the same page: no pending or error state in the title row. The CV button beside it keeps its own states (C1 shows it idle, C2 ready). On phones the action group wraps (C3).",
      "fill": "blue"
    },
    "nD5": {
      "x": 0,
      "y": 3340,
      "w": 420,
      "text": "D4 → D5 → Rewrite letter → D6 is the only path that shows the dialog. Regenerate from D3 (never edited, or saved back to exactly the generated text) goes straight to D6.",
      "fill": "blue"
    },
    "nSave": {
      "x": 480,
      "y": 3340,
      "w": 420,
      "text": "Save (D4) calls the PUT route directly, no confirmation. The owner chose to keep their own edit; only the AI overwrite is warned about.",
      "fill": "blue"
    },
    "nFail": {
      "x": 1520,
      "y": 3340,
      "w": 420,
      "text": "A failed Regenerate never reaches D7 and never clears the textarea: the letter stays, both buttons return to enabled, and an error toast says \"Couldn't write a letter. Try again\". D7 is only reachable from D1.",
      "fill": "blue"
    },
    "nKb": {
      "x": 2000,
      "y": 3340,
      "w": 420,
      "text": "Tabs, Textarea, Copy letter, Regenerate and Save are Tab stops. The dialog traps focus, Cancel takes it first, Escape closes it. Pending is the spinner replacing the icon plus the disabled button, never colour alone.",
      "fill": "blue"
    },
    "nCopy": {
      "x": 2480,
      "y": 3340,
      "w": 420,
      "text": "Copy letter copies the Textarea as it is now, edits included, and shows a \"Letter copied\" toast. It works on an unsaved edit too.",
      "fill": "blue"
    }
