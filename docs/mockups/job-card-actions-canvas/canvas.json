    "t": {
      "x": 0,
      "y": -280,
      "text": "Job listing card",
      "kind": "title1",
      "maxW": 4240
    },
    "n1": {
      "x": 4320,
      "y": 0,
      "w": 400,
      "text": "E3 → E4 and E5 → E6 each start from their own idle state. A card never shows both idle and ready for the same action. Pending spins in place; the modal opens on the next click once ready, never by itself.",
      "fill": "blue"
    },
    "n2": {
      "x": 4320,
      "y": 560,
      "w": 400,
      "text": "Clicking anywhere else on the card opens the posting's detail page as today. Save, Tailor CV, Write cover letter and Apply stop the click from reaching the card link.",
      "fill": "blue"
    },
    "n3": {
      "x": 4320,
      "y": 1120,
      "w": 400,
      "text": "Regenerate in either modal behaves exactly as on the detail page: Tailor overwrites silently; Cover letter asks first when the letter was edited (Rewrite this letter?). The dialog stacks over the modal; no narrower version needed.",
      "fill": "blue"
    },
    "n4": {
      "x": 4320,
      "y": 1680,
      "w": 400,
      "text": "Score and ATS carry their numbers as the signal, never colour. Every new control is a Tab stop; the modal traps focus and Escape closes it.",
      "fill": "blue"
    }
  },
